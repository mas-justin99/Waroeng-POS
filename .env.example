#--------------------------------------------------------------------
# Waroeng Mbok Reneo POS - contoh konfigurasi
# Salin menjadi ".env" (lokal / Laragon). Di Vercel isi lewat Project > Settings > Environment Variables.
#--------------------------------------------------------------------
CI_ENVIRONMENT = development

# URL aplikasi. Kosongkan di Vercel (otomatis memakai domain produksi).
APP_BASE_URL = http://localhost:8080/

# --- Database ---
# Laragon (MySQL bawaan):
DATABASE_URL = mysql://root@127.0.0.1:3306/waroeng_pos
# Neon (PostgreSQL) - dipakai saat deploy ke Vercel, boleh juga untuk lokal:
# DATABASE_URL = postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# --- Cloudinary (foto produk). Kosong = foto disimpan di public/uploads (hanya lokal) ---
# CLOUDINARY_URL = cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Menit tanpa aktivitas sebelum akun dianggap tidak aktif (perangkat lain baru boleh login)
SESSION_IDLE_MINUTES = 5
